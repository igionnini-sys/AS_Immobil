{
  "name": "immobiliare",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Analisi investimenti immobiliari offline per desktop e Android",
  "license": "UNLICENSED",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && vite build --config apps/desktop/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "desktop:dev": "npm run build && node scripts/desktop-run.mjs",
    "desktop:smoke": "node scripts/desktop-run.mjs --smoke-test",
    "desktop:dist": "npm run build && electron-builder --config apps/desktop/electron-builder.json",
    "desktop:pack": "npm run build && electron-builder --config apps/desktop/electron-builder.json --dir",
    "android:sync": "npm run build && npm run sync --workspace @immobil/mobile",
    "android:debug": "npm run android:sync && node scripts/android-build.mjs assembleDebug",
    "android:bundle": "npm run android:sync && node scripts/android-build.mjs bundleRelease",
    "test:ui": "vitest run tests/ui.test.tsx"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
